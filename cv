            display: block;
            padding: 15px 20px;
            background: #fafafa;
            border-left: 4px solid #3498db;
            border-radius: 4px;
            text-decoration: none;
            color: #2c3e50;
            font-weight: bold;
            transition: all 0.2s;
        }
        .lista-ejercicios a:hover {
            background: #f0f7fc;
            transform: translateX(5px);
        }
